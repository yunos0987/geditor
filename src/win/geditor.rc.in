// The resources of geditor.exe, generated by CMake (configure_file): the
// version from VERSION (Explorer > Properties > Details) and the application
// icon (tools/gen_icon.py writes src/win/geditor.ico). The icon has the lowest
// id, so Explorer and the taskbar use it.

#include <winver.h>

1 ICON "@PROJECT_SOURCE_DIR@/src/win/geditor.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Yunos"
      VALUE "FileDescription", "geditor"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "geditor"
      VALUE "LegalCopyright", "Copyright (c) 2026 Yunos. MIT License."
      VALUE "OriginalFilename", "geditor.exe"
      VALUE "ProductName", "geditor"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
